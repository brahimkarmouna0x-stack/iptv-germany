# Copy to .env.local for development, or configure as Environment Variables
# in the Vercel project settings for production. Nothing here is a real
# secret — these are placeholder names only.

# Supabase (used to serve the live support phone number, src/lib/settings.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fallback phone number used when Supabase is unreachable/unconfigured
# (E.164-style digits only, no "+", e.g. "49XXXXXXXXXX")
NEXT_PUBLIC_FALLBACK_PHONE=

# Secret bearer token required to call POST /api/revalidate
REVALIDATE_SECRET=

# Analytics — set ONE of these, not both (GTM usually loads GA4 itself)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# TMDB (movie/show metadata used on /popular)
NEXT_PUBLIC_TMDB_API_KEY=

# TheSportsDB — optional, falls back to the public test key "123" if unset
NEXT_PUBLIC_SPORTSDB_API_KEY=
